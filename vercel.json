{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "ai-organize.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/ai-organize",
      "dest": "/ai-organize.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
